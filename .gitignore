# --- Python (core of GitHub's Python template) ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments (publish the recipes, never the venvs) ---
.venv/
venv/
env/
*/.venv/

# --- IDE / editor ---
.idea/
.vscode/
*.sublime-*

# --- Windows artifacts ---
Thumbs.db
Desktop.ini
*.lnk

# --- Office temp/lock files (from editing the requirements workbook) ---
~$*.xlsx
~$*.docx

# --- Project-specific runtime outputs ---
telemetry_*.csv          # telemetry capture output
*.log                    # runtime logs (the curated TestRun logs are ADDED explicitly)
snapshots/               # save/load snapshot files, if directory-based
tile_cache/              # any cached OSM tiles (ODbL — fetch live instead)

# --- Local machine config, if any ---
*.local.yaml
